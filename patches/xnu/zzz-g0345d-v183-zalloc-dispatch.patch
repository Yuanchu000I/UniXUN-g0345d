--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -371,6 +371,55 @@
 	while (n--) *p++ = 0xFFFFFFFFu;
 }
 
+
+/*
+ * G0345D v183: post-VM ZALLOC diagnostics, independent of console output.
+ * Sixteen MSB-first cells, white=1, black=0, with a black gap in each cell.
+ * Exact RGB888 writes remain inside the 1080x2160, 3240-byte-stride buffer.
+ */
+static void
+g0345d_zalloc_word(int row, uint16_t value)
+{
+	if (g0345d_fb_va == 0) { return; }
+	for (int y = 0; y < 32; y++) {
+		volatile uint8_t *p = (volatile uint8_t *)(uintptr_t)
+		    (g0345d_fb_va + (uint64_t)(row + y) * 3240ULL + 60ULL * 3ULL);
+		for (int bit = 15; bit >= 0; bit--) {
+			uint8_t color = (value & (1u << bit)) ? 0xff : 0;
+			for (int x = 0; x < 60; x++) {
+				uint8_t c = x < 48 ? color : 0;
+				p[0] = c; p[1] = c; p[2] = c; p += 3;
+			}
+		}
+	}
+}
+
+void
+g0345d_zalloc_probe(unsigned int index, unsigned int stage,
+    uint64_t function, uint64_t argument)
+{
+	if (stage == 0) {
+		g0345d_zalloc_word(240, 0xaaaa);
+		return;
+	}
+	if (stage == 1) {
+		/* Reset only the four current-callback state bands. */
+		for (int n = 0; n < 4; n++) {
+			g0245d_paint_row_black(1600 + n * 60);
+		}
+		g0345d_zalloc_word(320, (uint16_t)index);
+		for (int n = 0; n < 4; n++) {
+			g0345d_zalloc_word(480 + n * 80,
+			    (uint16_t)(function >> (48 - n * 16)));
+			g0345d_zalloc_word(880 + n * 80,
+			    (uint16_t)(argument >> (48 - n * 16)));
+		}
+	}
+	if (stage >= 1 && stage <= 4) {
+		g0245d_paint_row_white(1600 + (int)(stage - 1) * 60);
+	}
+}
+
