+/*
+ * g0345d v167: paint a 64-bit value as a 32-cell binary bit-code band through
+ * the PROVEN TTBR0 identity map (VA 0x83401000). 16 rows tall, MSB first,
+ * white cell = bit 1, dark cell = bit 0, 8 px per cell starting at x=64.
+ */
+void
+g0245d_paint_bits(int row, uint64_t val)
+{
+	const uint64_t rowbytes = 0xCA8ULL;
+	volatile uint32_t *base = (volatile uint32_t *)(uintptr_t)
+	    (0x83401000ULL + (uint64_t)row * rowbytes + 64ULL * 4ULL);
+	int i, j;
+	for (i = 0; i < 16; i++) {
+		volatile uint32_t *p = base + i * (int)(rowbytes / 4);
+		for (j = 0; j < 32; j++) {
+			uint32_t color = ((val >> (31 - j)) & 1ULL) ? 0xFFFFFFFFu : 0xFF202020u;
+			int x;
+			for (x = 0; x < 8; x++)
+				p[x] = color;
+			p += 8;
+		}
+	}
+}
