+++ b/osfmk/arm64/arm_vm_init.c
@@ -2163,11 +2163,19 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 *   row 200 = gVirtBase + (0x83401000 - gPhysBase)   (classic physmap VA)
 	 *   row 250 = phystokv(0x83401000)                    (ptov_table VA) */
 	{
-		extern void g0245d_paint_bits(int row, uint64_t val);
-		g0245d_paint_bits(100, (uint64_t)gVirtBase);
-		g0245d_paint_bits(150, (uint64_t)gPhysBase);
-		g0245d_paint_bits(200, (uint64_t)gVirtBase + (0x83401000ULL - (uint64_t)gPhysBase));
-		g0245d_paint_bits(250, (uint64_t)phystokv(0x83401000ULL));
+		extern void g0245d_paint_halfband(int row, uint32_t half);
+		uint64_t vb = (uint64_t)gVirtBase;
+		uint64_t pb = (uint64_t)gPhysBase;
+		uint64_t cv = vb + (0x83401000ULL - pb);
+		uint64_t pv = (uint64_t)phystokv(0x83401000ULL);
+		g0245d_paint_halfband(400, (uint32_t)((vb >> 16) & 0xFFFFu));
+		g0245d_paint_halfband(440, (uint32_t)(vb & 0xFFFFu));
+		g0245d_paint_halfband(500, (uint32_t)((pb >> 16) & 0xFFFFu));
+		g0245d_paint_halfband(540, (uint32_t)(pb & 0xFFFFu));
+		g0245d_paint_halfband(600, (uint32_t)((cv >> 16) & 0xFFFFu));
+		g0245d_paint_halfband(640, (uint32_t)(cv & 0xFFFFu));
+		g0245d_paint_halfband(700, (uint32_t)((pv >> 16) & 0xFFFFu));
+		g0245d_paint_halfband(740, (uint32_t)(pv & 0xFFFFu));
 	}
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
