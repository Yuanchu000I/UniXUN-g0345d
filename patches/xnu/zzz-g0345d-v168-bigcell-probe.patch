+/*
+ * g0345d v168: paint a 16-bit half-word as 16 big cells (64 px wide, 24 rows
+ * tall) through the proven TTBR0 identity map. White cell = bit 1, black cell
+ * = bit 0, MSB first, cells start at fb x = 28.
+ */
+void
+g0245d_paint_halfband(int row, uint32_t half)
+{
+	const uint64_t rowbytes = 0xCA8ULL;
+	volatile uint32_t *base = (volatile uint32_t *)(uintptr_t)
+	    (0x83401000ULL + (uint64_t)row * rowbytes + 28ULL * 4ULL);
+	int i, j, x;
+	for (i = 0; i < 24; i++) {
+		volatile uint32_t *p = base + i * (int)(rowbytes / 4);
+		for (j = 0; j < 16; j++) {
+			uint32_t color = ((half >> (15 - j)) & 1u) ? 0xFFFFFFFFu : 0x00000000u;
+			for (x = 0; x < 64; x++)
+				p[x] = color;
+			p += 64;
+		}
+	}
+}
+
 void
 g0245d_fill_fb_black(void)
 {
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
