+void
+g0245d_probe_paint(int which)
+{
+	const uint64_t rowbytes = 0xCA8ULL;
+	extern vm_offset_t gVirtBase;
+	extern vm_offset_t gPhysBase;
+	extern vm_map_address_t phystokv(pmap_paddr_t pa);
+	const uint64_t fb_pa = 0x83401000ULL + (uint64_t)which * 40ULL * rowbytes;
+	uint64_t va;
+	volatile uint32_t *p;
+	uint64_t n;
+	if (which == 1) {
+		va = (uint64_t)phystokv(fb_pa);
+	} else {
+		va = (uint64_t)gVirtBase + (fb_pa - (uint64_t)gPhysBase);
+	}
+	p = (volatile uint32_t *)(uintptr_t)va;
+	n = (24ULL * rowbytes) / 4;
+	while (n--) *p++ = 0xFFFFFFFFu;
+}
+
 void
 g0245d_fill_fb_black(void)
 {
