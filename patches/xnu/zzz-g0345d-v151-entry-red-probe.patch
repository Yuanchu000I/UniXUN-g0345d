--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -486,5 +486,26 @@
 	// g0245d: stage 0 - kernel entry point reached.
 	BOOT_MARK x0, 0
 
+	// g0345d v151: full-screen red probe immediately at the kernel entry.
+	// If the panel turns solid red the kernel entry really executed (any
+	// reset after that is an in-kernel death); a black reset with no red
+	// means the death is before the entry (loader hand-off). Painted with
+	// the same boot_args Video[] offsets as BOOT_MARK, 32-bit stores across
+	// the whole framebuffer, then the white stage bands drawn later stay
+	// countable on top of the red. Clobbers x9-x13 (same as BOOT_MARK).
+	ldr	x9, [x0, #0x28]			// Video[0] = framebuffer PA
+	cbz	x9, 7f
+	ldr	x10, [x0, #0x38]		// Video[2] = row bytes
+	cbz	x10, 7f
+	ldr	x11, [x0, #0x48]		// Video[4] = height
+	mul	x12, x10, x11			// bytes = rowbytes * height
+	lsr	x12, x12, #2
+	mov	w13, #0x00FF0000		// BGRA red (B=00 G=00 R=FF)
+1:	str	w13, [x9], #4
+	subs	x12, x12, #1
+	b.ne	1b
+	dsb	sy
+7:
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
