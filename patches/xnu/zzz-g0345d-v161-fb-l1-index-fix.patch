@@ -133,7 +133,7 @@
 	.align 3
 	.globl EXT(g0245d_fb_base)
 LEXT(g0245d_fb_base)
-	.quad	0xC3401000			// framebuffer mapped VA (bootstrap L1 idx 3 -> PA 0x83401000)
+	.quad	0x83401000			// framebuffer mapped VA (bootstrap L1 idx 2 -> PA 0x83401000)
 	.globl EXT(g0245d_fb_rowbytes)
 LEXT(g0245d_fb_rowbytes)
 	.quad	3240				// 1080 px * 3 bytes (RGB888)
@@ -191,8 +191,8 @@
 	 * quads are treated as pointers they become a slid, invalid VA and
 	 * every band painted after arm_init's first call silently vanishes.
 	 * Immediates make the helper valid across __startup_func rebasing. */
-	movz	x1, #0xC340, lsl #16
-	movk	x1, #0x1000			// x1 = 0xC3401000
+	movz	x1, #0x8340, lsl #16
+	movk	x1, #0x1000			// x1 = 0x83401000 (g0345d: L1 idx 2 identity)
 	movz	x2, #0xCA8			// x2 = 3240 (1080 * 3)
