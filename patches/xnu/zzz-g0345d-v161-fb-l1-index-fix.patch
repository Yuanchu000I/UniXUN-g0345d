@@ -885,14 +885,16 @@
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
-	/* g0245d v122: map the firmware framebuffer as a 1GB block at L1 index 3
-	 * of the V=P (TTBR0) table. VA 0xC0000000 -> PA 0x80000000, so VA
-	 * 0xC3401000 resolves to PA 0x83401000. We cannot reuse the kernel
-	 * window's index 2 (which holds the kernel PA 0x95400000 and would be
-	 * clobbered by a 1GB block there). Device attributes so the write reaches
-	 * the panel instead of stalling in the cache. TTE = 0x8000060D
-	 * (PA 0x80000000 | VALID | SH(OUTER) | ATTR(DISABLE) | AF). */
-	add	x9, x25, #0x18			// L1 index 3 (3 * 8 bytes) in V=P table
+	/* g0345d v161: map the firmware framebuffer as a 1GB block at L1 index 2
+	 * of the V=P (TTBR0) table. VA 0x80000000 -> PA 0x80000000 (identity),
+	 * so VA 0x83401000 resolves to PA 0x83401000. We CANNOT use L1 index 3
+	 * like g0245d did: on g0345d the kernel PA 0xD0A04000 is ALSO in L1
+	 * index 3, so writing a 1GB block there overwrites the kernel's own
+	 * mapping and the MMU enable faults immediately. L1 index 2 is free on
+	 * g0345d (kernel PA is 0xD0A04000, i.e. index 3). Device attributes so
+	 * the write reaches the panel instead of stalling in the cache.
+	 * TTE = 0x8000060D (PA 0x80000000 | VALID | SH(OUTER) | ATTR(DISABLE) | AF). */
+	add	x9, x25, #0x10			// L1 index 2 (2 * 8 bytes) in V=P table (g0345d: index 3 is the kernel!)
 	MOV64	x0, 0x8000060D
 	str	x0, [x9]
 	dsb	ish
