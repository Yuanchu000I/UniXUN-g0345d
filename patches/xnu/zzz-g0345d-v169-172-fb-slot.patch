diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index ec7b44a..3c2d916 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -216,6 +216,13 @@ g0245d_paint_stage_vm(int index)
 }
 
 
+/*
+ * g0345d v169: framebuffer VA mapped into TTBR1 by arm_vm_init() before the
+ * switch. Every post-switch painter goes through this slot; the classic
+ * gVirtBase math collapsed to an identity VA on this board and faulted.
+ */
+vm_offset_t g0345d_fb_va = 0;
+
 /*
  * g0345d v163: pre/post-TTBR-switch paint helpers.
  * Pre-switch: identity VA 0x83401000 (v161 L1 index 2 block).
@@ -246,11 +253,10 @@ void
 g0245d_paint_row_black(int row)
 {
 	const uint64_t rowbytes = 0xCA8ULL;
-	extern vm_offset_t gVirtBase;
-	extern vm_offset_t gPhysBase;
-	uint64_t va = (uint64_t)gVirtBase + (0x83401000ULL + (uint64_t)row * rowbytes
-	                                      - (uint64_t)gPhysBase);
-	volatile uint32_t *p = (volatile uint32_t *)(uintptr_t)va;
+	/* v169: write through the explicit TTBR1 fb slot (v163 math faults here). */
+	if (g0345d_fb_va == 0) { return; }
+	volatile uint32_t *p = (volatile uint32_t *)(uintptr_t)
+	    (g0345d_fb_va + (uint64_t)row * rowbytes);
 	uint64_t n = (16ULL * rowbytes) / 4;
 	while (n--) *p++ = 0x00000000u;
 }
@@ -266,12 +272,13 @@ g0245d_probe_paint(int which)
 	uint64_t va;
 	volatile uint32_t *p;
 	uint64_t n;
-	if (which == 1) {
-		va = (uint64_t)phystokv(fb_pa);
-	} else {
-		va = (uint64_t)gVirtBase + (fb_pa - (uint64_t)gPhysBase);
-	}
-	p = (volatile uint32_t *)(uintptr_t)va;
+	(void)fb_pa;
+	(void)phystokv;
+	(void)gVirtBase;
+	(void)gPhysBase;
+	if (g0345d_fb_va == 0) { return; }
+	p = (volatile uint32_t *)(uintptr_t)
+	    (g0345d_fb_va + (uint64_t)which * 40ULL * rowbytes);
 	n = (24ULL * rowbytes) / 4;
 	while (n--) *p++ = 0xFFFFFFFFu;
 }
@@ -329,8 +336,8 @@ g0245d_fill_fb_black(void)
 	const uint64_t rowbytes = 0xCA8ULL;
 	extern vm_offset_t gVirtBase;
 	extern vm_offset_t gPhysBase;
-	uint64_t va = (uint64_t)gVirtBase + (0x83401000ULL - (uint64_t)gPhysBase);
-	volatile uint32_t *p = (volatile uint32_t *)(uintptr_t)va;
+		if (g0345d_fb_va == 0) { return; }
+	volatile uint32_t *p = (volatile uint32_t *)(uintptr_t)g0345d_fb_va;
 	uint64_t n = (2160ULL * rowbytes) / 4;
 	while (n--) *p++ = 0x00000000u;
 }
@@ -341,9 +348,9 @@ g0245d_paint_row_white(int row)
 	const uint64_t rowbytes = 0xCA8ULL;
 	extern vm_offset_t gVirtBase;
 	extern vm_offset_t gPhysBase;
-	uint64_t va = (uint64_t)gVirtBase + (0x83401000ULL + (uint64_t)row * rowbytes
-	                                      - (uint64_t)gPhysBase);
-	volatile uint32_t *p = (volatile uint32_t *)(uintptr_t)va;
+	if (g0345d_fb_va == 0) { return; }
+	volatile uint32_t *p = (volatile uint32_t *)(uintptr_t)
+	    (g0345d_fb_va + (uint64_t)row * rowbytes);
 	uint64_t n = (16ULL * rowbytes) / 4;
 	while (n--) *p++ = 0xFFFFFFFFu;
 }
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 30b06c3..a828d3d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2177,7 +2177,45 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 		g0245d_paint_halfband(700, (uint32_t)((pv >> 16) & 0xFFFFu));
 		g0245d_paint_halfband(740, (uint32_t)(pv & 0xFFFFu));
 	}
+	/* g0345d v169: explicit framebuffer mapping in the TTBR1 tables.
+	 * v167 showed gVirtBase == gPhysBase on this board, so the classic
+	 * physmap VA math produced the identity address and every post-switch
+	 * write faulted. Install a dedicated 2MB block slot 256MB below
+	 * VM_MAX_KERNEL_ADDRESS covering fb PA 0x83401000, and route all
+	 * post-switch painters through g0345d_fb_va. */
+	{
+		extern vm_offset_t g0345d_fb_va;
+		vm_offset_t fb_slot = (VM_MAX_KERNEL_ADDRESS - 0x10000000ULL) & ~ARM_TT_L2_OFFMASK;
+		tt_entry_t *l1_tte_fb = cpu_tte + ((fb_slot & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
+		vm_offset_t l2_page;
+		tt_entry_t *l2_tte_fb;
+		unsigned int i;
+		if (*l1_tte_fb == ARM_TTE_EMPTY) {
+			l2_page = alloc_ptpage(TRUE);
+			bzero((void *)l2_page, ARM_PGBYTES);
+			*l1_tte_fb = (kvtophys(l2_page) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID
+			    | ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA);
+		} else {
+			l2_page = phystokv((*l1_tte_fb) & ARM_TTE_TABLE_MASK);
+		}
+		l2_tte_fb = (tt_entry_t *)l2_page + ((fb_slot & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT);
+		uint64_t block_base = 0x83401000ULL & ARM_TTE_BLOCK_L2_MASK;
+		*l2_tte_fb = (block_base & ARM_TTE_BLOCK_L2_MASK) | ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID
+		    | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_NX | ARM_TTE_BLOCK_AP(0)
+		    | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITEBACK);
+		/* keep the rest of the fresh L2 page harmless (invalid), as alloc_ptpage
+		 * does NOT zero the page (v170 fix: explicit bzero above). */
+		(void)i;
+		/* v171 fix: the 32MB L2 block base is 0x82000000, fb sits at offset
+		 * 0x1401000 inside it. Painters add row offsets to fb_va, so fb_va must
+		 * include the intra-block offset or writes land 20MB before the fb. */
+		g0345d_fb_va = fb_slot + (0x83401000ULL - block_base);
+	}
+	/* g0345d v172: A-mark - slot installed, still on bootstrap TTBR0. */
+	g0245d_paint_row(1450);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
+	/* g0345d v172: B-mark - alt-switch done, TTBR0 bootstrap still live. */
+	g0245d_paint_row(1470);
 
 	/* g0345d v164: TTBR1 physmap probe while TTBR0 bootstrap table is still
 	 * live. cpu_ttep (set by set_mmu_ttb_alternate just above) maps the
@@ -2187,6 +2225,8 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	 * missing 1560 = the invalid_ttep switch itself faults. */
 	extern void g0245d_paint_row_black(int row);
 	g0245d_paint_row_black(1500);
+	/* g0345d v172: C-mark - survived the first fb_va write. */
+	g0245d_paint_row(1520);
 
 #if XNU_MONITOR
 	ml_enable_monitor();
