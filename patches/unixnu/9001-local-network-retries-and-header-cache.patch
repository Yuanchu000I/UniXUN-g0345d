+def jsdelivr_url(url):
+    """raw.githubusercontent.com/<owner>/<repo>/<ref>/<path> -> jsdelivr CDN,
+    reachable from this network without the proxy."""
+    parts = urllib.parse.urlsplit(url)
+    if parts.hostname != 'raw.githubusercontent.com':
+        return None
+    segments = parts.path.lstrip('/').split('/', 2)
+    if len(segments) < 3 or '@' in segments[2].split('/')[0]:
+        return None
+    owner, repo, rest = segments
+    return f'https://cdn.jsdelivr.net/gh/{owner}/{repo}@{rest}'
+
+
+def fetch_once(url, opener=None, timeout=60):
+    # curl survives where python-urllib's TLS handshake gets reset on this
+    # network.  -x '' ignores the env proxies (the profile exports them), so
+    # this goes DIRECT, which is what we want for the CDN endpoints.
+    result = subprocess.run(['curl', '-sfL', '-x', '', '--max-time', str(timeout),
+                             '-A', 'unixnu-prepare-xnu-source', url], capture_output=True)
+    if result.returncode != 0:
+        raise RuntimeError(f'curl exit {result.returncode} for {url}')
+    return result.stdout
+
