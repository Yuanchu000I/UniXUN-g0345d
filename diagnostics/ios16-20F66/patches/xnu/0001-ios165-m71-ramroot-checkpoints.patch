--- /dev/null
+++ b/osfmk/kern/ios165_m71_ramroot_probe.h
@@ -0,0 +1,27 @@
+/*
+ * Source-only RAM-root checkpoint ABI for XNU 8796.101.5 / iOS 16.5.
+ * This is independent of the old XNU 10063 M71 framebuffer backend.
+ *
+ * Disabled by default: no observer symbol or argument evaluation.
+ * Enabling IOS165_M71_RAMROOT_OBSERVER=1 requires one real implementation
+ * of ios165_m71_ramroot_observer(unsigned int, unsigned int). The provider
+ * must be safe at every marked boot boundary and must not alter boot state.
+ * No fallback provider is supplied. Enabling without it must fail to link.
+ */
+#ifndef _KERN_IOS165_M71_RAMROOT_PROBE_H_
+#define _KERN_IOS165_M71_RAMROOT_PROBE_H_
+
+#if defined(IOS165_M71_RAMROOT_OBSERVER) && IOS165_M71_RAMROOT_OBSERVER
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern void ios165_m71_ramroot_observer(unsigned int phase, unsigned int value);
+#ifdef __cplusplus
+}
+#endif
+#define IOS165_M71_RAMROOT_EVENT(phase, value)     ios165_m71_ramroot_observer((phase), (value))
+#else
+#define IOS165_M71_RAMROOT_EVENT(phase, value) do { } while (0)
+#endif
+
+#endif /* _KERN_IOS165_M71_RAMROOT_PROBE_H_ */
